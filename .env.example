# LLM
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
# Qwen strict function calls default to non-thinking mode. Override vendor parameters if needed.
LLM_EXTRA_BODY={}
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=3072

# 会话与缓存
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60

# Agent 编排
MAX_STEPS=24
MAX_REPLANS=2
MEMORY_MAX_FACTS=8
MEMORY_CONTEXT_TOKENS=3000
RAG_TOP_K=5

# Durable checkpoints and event archive. One execution worker per database.
DATABASE_PATH=data/aegisflow.db
DEMO_AUTH=true
COOKIE_SECURE=false
# Production: DEMO_AUTH=false, configure staff credentials server-side.
# API_USERS={"your-secret-token":{"actor_id":"staff-1","tenant":"demo","level":1}}
API_USERS={}
ALLOWED_ORIGINS=[]
TOOL_TIMEOUT_SECONDS=15
TOOL_RATE_LIMIT_PER_MINUTE=120

# Optional independent MCP service; empty URL selects the typed local executor.
MCP_URL=
MCP_API_KEY=

# 可观测性
ENABLE_TRACING=true
TRACE_PROVIDER=json
TRACE_LOG_PATH=logs/traces.jsonl

# 评测
EVAL_TOP_K=5
EVAL_REPORT_PATH=reports/eval_report.json
